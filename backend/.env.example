# Audio Notes Platform - Environment Configuration

# Database: SQLite for local dev or PostgreSQL for production (Render/Supabase/Neon)
DATABASE_URL=sqlite:///./audio_notes.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gnani ASR Configuration (Sign up at gnani.ai, get key from dashboard)
# Leave blank or mock to run in high-fidelity sandbox simulation
GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_DEFAULT_LANGUAGE=en-IN

# LLM Summarizer Configuration
# Options: auto, gemini, openai, groq, mock
LLM_PROVIDER=auto

# Provide at least one key for live LLM summarization (or leave blank for heuristic summary)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Storage Configuration
# Options: local, s3
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# S3 Configuration (Optional - for Supabase Storage, Cloudflare R2, or AWS S3)
# S3_BUCKET_NAME=audio-notes
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# CORS
CORS_ORIGINS=["*"]
